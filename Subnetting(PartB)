#include <iostream>
#include <cmath>
using namespace std;


int main() {


    string ip;
    int subnets;


    cout << "Enter IP Address: ";
    cin >> ip;


    cout << "Enter number of subnets required: ";
    cin >> subnets;


    // Get first part of IP address
    int first = 0;
    int i = 0;


    while (ip[i] != '.') {
        first = first * 10 + (ip[i] - '0');
        i++;
    }


    int defaultMask;


    if (first <= 126) {
        defaultMask = 8;
    }
    else if (first <= 191) {
        defaultMask = 16;
    }
    else {
        defaultMask = 24;
    }


    int bits = 0;


    while (pow(2, bits) < subnets) {
        bits++;
    }


    int newMask = defaultMask + bits;


    cout << "\n--- SUBNETTING ---" << endl;
    cout << "IP Address: " << ip << endl;
    cout << "Default Subnet Mask: /" << defaultMask << endl;
    cout << "Number of Subnets: " << subnets << endl;
    cout << "Borrowed Bits: " << bits << endl;
    cout << "New Subnet Mask: /" << newMask << endl;


    int maskValue = 256 - (int)pow(2, 8 - bits);


    if (newMask <= 16) {
        cout << "Subnet Mask: 255." << maskValue << ".0.0" << endl;
    }
    else if (newMask <= 24) {
        cout << "Subnet Mask: 255.255." << maskValue << ".0" << endl;
    }
    else {
        cout << "Subnet Mask: 255.255.255." << maskValue << endl;
    }


    return 0;
}
