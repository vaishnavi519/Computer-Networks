#include <iostream>
using namespace std;

#define INF 999

int main() {
    int n;
    cout << "Enter number of routers: ";
    cin >> n;

    int cost[20][20];
    int dist[20][20];
    int nextHop[20][20];

    cout << "\nEnter the cost matrix:\n";
    cout << "(Enter 999 if there is no direct connection)\n";

    for (int i = 0; i < n; i++) {
        for (int j = 0; j < n; j++) {
            cin >> cost[i][j];

            dist[i][j] = cost[i][j];

            if (cost[i][j] != INF && i != j)
                nextHop[i][j] = j;
            else
                nextHop[i][j] = -1;
        }
    }

    // Distance Vector Routing Algorithm
    for (int k = 0; k < n; k++) {
        for (int i = 0; i < n; i++) {
            for (int j = 0; j < n; j++) {

                if (dist[i][k] + dist[k][j] < dist[i][j]) {
                    dist[i][j] = dist[i][k] + dist[k][j];
                    nextHop[i][j] = nextHop[i][k];
                }
            }
        }
    }

    // Print final routing table
    cout << "\nFinal Routing Tables:\n";

    for (int i = 0; i < n; i++) {
        cout << "\nRouter " << i + 1 << ":\n";
        cout << "Destination\tCost\tNext Hop\n";

        for (int j = 0; j < n; j++) {
            cout << j + 1 << "\t\t";

            if (dist[i][j] >= INF)
                cout << "INF\t";
            else
                cout << dist[i][j] << "\t";

            if (i == j)
                cout << "-\n";
            else
                cout << nextHop[i][j] + 1 << "\n";
        }
    }

    return 0;
}
